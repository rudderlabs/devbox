{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageClass": { "type": "string" },
        "volumeSnapshotClass": { "type": "string" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "size": { "type": "string" } }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9._-]+\\.git$" },
          "branch": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" }
        }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["openai", "anthropic"] },
        "baseUrl": { "type": "string", "pattern": "^(https?://[^/?#:]+(/[^?#]*)?)?$" },
        "model": { "type": "string", "pattern": "^(|.*\\S.*)$" },
        "reasoningEffort": { "$ref": "#/definitions/reasoningEffort" },
        "stages": {
          "description": "Stage keys must stay in sync with templates/_helpers.tpl devbox.llmStages.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "orientation": { "$ref": "#/definitions/llmStage" },
            "planning": { "$ref": "#/definitions/llmStage" },
            "planReview": { "$ref": "#/definitions/llmStage" },
            "implementation": { "$ref": "#/definitions/llmStage" },
            "distillation": { "$ref": "#/definitions/llmStage" },
            "review": { "$ref": "#/definitions/llmStage" },
            "followup": { "$ref": "#/definitions/llmStage" }
          }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 1 }, "email": { "type": "string", "minLength": 3 } }
    },
    "ironProxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clusterIP": { "type": "string", "pattern": "^(([0-9]{1,3}\\.){3}[0-9]{1,3})?$" },
        "extraAllowlist": { "type": "array", "items": { "type": "object", "required": ["host"] } },
        "replicas": { "type": "integer", "minimum": 1 },
        "image": { "type": "object" },
        "resources": { "type": "object" }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": "string" },
        "memory": { "type": "string" },
        "maxConcurrent": { "type": "integer", "minimum": 1 },
        "runtimeClassName": { "type": "string" },
        "tolerations": { "type": "array" },
        "nodeSelector": { "type": "object" },
        "imagePullSecrets": { "type": "array" },
        "extraVolumes": { "type": "array" },
        "extraVolumeMounts": { "type": "array" }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controlPlane": { "type": "string" },
        "controlPlanePullSecrets": { "type": "array" },
        "harness": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github": { "$ref": "#/definitions/existingSecret" },
        "githubApp": { "$ref": "#/definitions/existingSecret" },
        "llm": { "$ref": "#/definitions/existingSecret" },
        "integrations": { "$ref": "#/definitions/existingSecret" }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linear": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" }, "clientId": { "type": "string" } }
        },
        "slack": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "channelId": { "type": "string" },
            "notifySources": { "type": "array", "items": { "enum": ["linear", "api"] } }
          }
        },
        "githubApp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "appId": { "type": "integer", "minimum": 0 },
            "installationId": { "type": "integer", "minimum": 0 },
            "botLogin": { "type": "string" },
            "botUserId": { "type": "integer", "minimum": 0 },
            "tokens": { "enum": ["", "devbox", "external"] },
            "tokenScope": { "enum": ["repos", "installation"] },
            "ciResults": { "type": "boolean" }
          }
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trustedOrgs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "trustedUsers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "publicBaseUrl": { "type": "string" },
        "resources": { "type": "object" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" }, "image": { "type": "string" }, "size": { "type": "string" } }
    },
    "database": { "$ref": "#/definitions/existingSecret" },
    "snapshotBuilder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schedule": { "type": "string" },
        "suspend": { "type": "boolean" },
        "keep": { "type": "integer", "minimum": 1 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "webhooks": { "$ref": "#/definitions/ingress" },
        "api": { "$ref": "#/definitions/ingress" }
      }
    },
    "extraEnv": { "type": "array" },
    "extraManifests": { "type": "array" },
    "opensandbox": { "type": "object" }
  },
  "definitions": {
    "reasoningEffort": {
      "enum": ["", "none", "minimal", "low", "medium", "high", "xhigh", "max"]
    },
    "llmStage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "reasoningEffort": { "$ref": "#/definitions/reasoningEffort" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "annotations": { "type": "object" },
        "tls": { "type": "array" }
      }
    },
    "existingSecret": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "existingSecret": { "type": "string" } }
    }
  }
}

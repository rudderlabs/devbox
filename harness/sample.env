export WORKSPACE="<your-local-workspace-dir>"

# ── GitHub ────────────────────────────────────────────────────────────────
# Local dev only. In-sandbox runs leave these unset — iron-proxy injects the
# equivalents (dummy token swapped server-side, CA mounted into the sandbox).
export GITHUB_TOKEN="<your PAT with repo scope>"
# export GITHUB_API_URL="https://api.github.com"

# ── Git commit signing ────────────────────────────────────────────────────
# Optional. Set these only if you want the harness to import/configure GPG
# signing itself. If unset, the harness leaves git signing alone and `git
# commit` uses whatever local config already exists. In-sandbox, point
# HARNESS_GPG_PRIVATE_KEY_FILE at the Secret-mounted armored private key file.
# export HARNESS_GIT_SIGNER_NAME="Sandbox Signing Bot"
# export HARNESS_GIT_SIGNER_EMAIL="sandbox-signer@company.com"
# export HARNESS_GPG_PRIVATE_KEY_FILE="/run/git-signing/private.asc"
# export HARNESS_GPG_KEY_ID="<optional fingerprint or long key id>"

# ── DeepAgents model + LLM connection (HARNESS_*) ─────────────────
# Each stage resolves model and effort independently:
#   HARNESS_<STAGE>_* → HARNESS_MODEL / HARNESS_REASONING_EFFORT → code default.
# On a deployment (Compose or Kubernetes) these come from devbox.config.json's
# llm block; set them here only for a harness run without a control plane.
# Stages: ORIENTATION PLANNING PLAN_REVIEW IMPLEMENTATION DISTILLATION REVIEW
#         FOLLOWUP
# Exact efforts: openai: none minimal low medium high xhigh
#                anthropic: low medium high xhigh max

# openai (default, the Responses API of OpenAI or Azure OpenAI) or anthropic
# (the Messages API). In-sandbox HARNESS_LLM_API_KEY holds the egress proxy's
# placeholder, which the proxy swaps for the real key.
# export HARNESS_LLM_PROVIDER="anthropic"
# openai: the base URL with /v1. anthropic: the API root without /v1, for
# example https://api.anthropic.com.
export HARNESS_LLM_BASE_URL="https://<your-llm-host>/v1"
# In a deployed control plane this allowlisted name holds only the proxy dummy,
# never the real key. For a harness run without a control plane, pass the real
# key to that one process:
#   HARNESS_LLM_API_KEY="$LLM_API_KEY" harness daemon
export LLM_API_KEY="<your LLM API key>"
# Code-model fallbacks are gpt-5.6-sol (openai) and claude-opus-5-5
# (anthropic). They apply only to a standalone harness; deployed runs derive
# HARNESS_MODEL and stage overrides from the llm block.
# export HARNESS_MODEL="gpt-5.6-sol"
# export HARNESS_ORIENTATION_REASONING_EFFORT="low"         # code default
# export HARNESS_PLANNING_REASONING_EFFORT="medium"         # code default
# export HARNESS_PLAN_REVIEW_REASONING_EFFORT="low"         # code default
# export HARNESS_IMPLEMENTATION_REASONING_EFFORT="medium"   # code default
# export HARNESS_DISTILLATION_REASONING_EFFORT="medium"     # code default
# export HARNESS_REVIEW_REASONING_EFFORT="high"             # code default
# export HARNESS_FOLLOWUP_REASONING_EFFORT="high"           # code default
# One effort for every stage. It replaces all seven defaults above, so set a
# stage's own effort to keep that stage lower.
# export HARNESS_REASONING_EFFORT="high"

# ── DeepAgents runtime knobs (all have sensible defaults) ─────────────────
# export HARNESS_REVIEW_MAX_PARALLEL_LENSES="6"
# export HARNESS_REVIEW_MAX_ITERATIONS="2"               # 1 = review-only, no fix pass
# export HARNESS_REVIEW_ENABLED="true"
# export HARNESS_DEEPAGENTS_MODEL_MAX_RETRIES="5"
# export HARNESS_DEEPAGENTS_MODEL_TIMEOUT_SECONDS="180"    # streaming HTTP read inactivity
# export HARNESS_DEEPAGENTS_MAX_RETRIES="3"
# export HARNESS_DEEPAGENTS_RETRY_BASE_SECONDS="10"
# export HARNESS_DEEPAGENTS_RETRY_MAX_SECONDS="300"
# export HARNESS_DEEPAGENTS_RATE_LIMIT_MIN_SECONDS="30"

# ── Langfuse tracing (opt-in) ─────────────────────────────────────────────
# Requires: uv sync
# When enabled, the harness emits stage spans to Langfuse.
# Default is off. Enable tracing explicitly:
# export HARNESS_LANGFUSE_ENABLED="true"
# export HARNESS_LANGFUSE_ENABLED="false"
# In-sandbox: leave LANGFUSE_AUTH unset (dummy-langfuse-auth) or set a proxy placeholder;
# iron-proxy swaps Authorization on egress for the harness SDK.
# Local dev with real keys: set LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY instead.
# export LANGFUSE_AUTH="<placeholder or pk-lf-...:sk-lf-...>"
# Optional override; default is https://us.cloud.langfuse.com
# export LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

# ── Daemon ────────────────────────────────────────────────────────────────
# Inbox poll cadence in seconds. Positive number; unset / unparseable / <= 0
# falls back to the 1.0s default.
# export HARNESS_POLL_INTERVAL_SECONDS="1.0"

# Pre-planning repo sync (default on). During assignment setup the harness
# fast-forwards every checkout under WORKSPACE to origin so planning and
# implementation don't run against a stale snapshot (the attached repos are
# re-snapshotted only every ~30 min). Set false to disable.
# export HARNESS_SYNC_REPOS_BEFORE_PLANNING="true"

FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d

WORKDIR /app

# kubectl required at runtime — see runtime Dockerfile rationale. docker-cli
# serves SANDBOX_RUNTIME=docker (local compose stack, host socket mounted).
ARG KUBECTL_VERSION=v1.37.1
RUN set -eux \
  && apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl docker-cli \
  && arch="$(dpkg --print-architecture)" \
  && curl -fsSLo /usr/local/bin/kubectl \
       "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${arch}/kubectl" \
  && expected="$(curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${arch}/kubectl.sha256")" \
  && echo "${expected}  /usr/local/bin/kubectl" | sha256sum -c - \
  && chmod +x /usr/local/bin/kubectl \
  && kubectl version --client=true \
  && rm -rf /var/lib/apt/lists/*

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .

EXPOSE 3000
CMD ["bun", "run", "dev"]

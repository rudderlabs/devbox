DATABASE_URL=postgres://devbox:devbox@localhost:5432/devbox
PORT=3000
AUTO_MIGRATE=true

# Linear (optional). LINEAR_ENABLED=true turns it on, and then all three
# settings are required (startup fails otherwise). Unset, empty or false: off,
# and the settings are ignored. Any other value is a startup error.
LINEAR_ENABLED=false
# LINEAR_CLIENT_ID=<linear-client-id>
# LINEAR_CLIENT_SECRET=<linear-client-secret>
# LINEAR_WEBHOOK_SECRET=<linear-webhook-secret>

# Slack task-completion notifications (optional). SLACK_ENABLED=true turns them
# on, and then the bot token (xoxb-…) and channel id are required.
SLACK_ENABLED=false
# SLACK_BOT_TOKEN=<slack-bot-token>
# SLACK_CHANNEL_ID=<slack-channel-id>
# Task sources whose finished tasks post, comma-separated: linear, api.
# Default: linear.
# SLACK_NOTIFY_SOURCES=linear

# The CP's own GitHub token. The Docker Compose stack (`bun run up`) does not
# read this file: it passes GITHUB_TOKEN from the shell, `gh auth token` or a
# prompt, and also uses it for sandboxes through iron-proxy.
GITHUB_TOKEN=<github-token>

# GitHub webhooks (optional). GITHUB_WEBHOOKS_ENABLED=true enables
# /webhook/github, and then GITHUB_WEBHOOK_SECRET, GITHUB_BOT_LOGIN,
# GITHUB_BOT_USER_ID and at least one of GITHUB_TRUSTED_ORGS /
# GITHUB_TRUSTED_USERS are required (startup fails otherwise).
GITHUB_WEBHOOKS_ENABLED=false
# GITHUB_WEBHOOK_SECRET=<github-webhook-secret>
# Login of the GitHub App / bot account. @<login> mentions trigger it.
# GITHUB_BOT_LOGIN=<bot-login>
# Numeric GitHub user id of the bot account (sender.id of the bot's webhooks).
# Used by the workflow_run trust gate.
# GITHUB_BOT_USER_ID=<github-bot-user-id>

# Whose comments the agent trusts, no defaults (fail closed). Comma- or
# space-separated. ORGS: every member of these orgs. USERS: these GitHub logins,
# resolved to numeric ids through the GitHub API. Both are forwarded to the
# sandbox for PR-discussion trust.
# GITHUB_TRUSTED_ORGS=<org>
# GITHUB_TRUSTED_USERS=<login>

SANDBOX_RESOURCE_CPU=2
SANDBOX_RESOURCE_MEMORY=24Gi
# Only the HARNESS_* settings explicitly listed in src/forwardedEnv.ts are
# forwarded to sandboxes. Never put a real secret under a forwarded name.
# The LLM endpoint. The control plane does not check it at startup, but the
# harness needs it: without it, a task fails at its first model call. With
# `bun run up`, these come from devbox.config.json's `llm` and iron-proxy
# intercepts the host.
# openai (default, the Responses API) or anthropic (the Messages API).
# HARNESS_LLM_PROVIDER=openai
# openai: the base URL with /v1. anthropic: the API root without /v1.
HARNESS_LLM_BASE_URL=https://<llm-host>/v1
# HARNESS_MODEL=gpt-5.6-sol
# HARNESS_LLM_API_KEY is forwarded to sandboxes, so it only ever holds the
# dummy the egress proxy swaps for the real key (docker-compose.yml sets it;
# the real key is LLM_API_KEY, read by iron-proxy).
HARNESS_POLL_INTERVAL_SECONDS=0.5
# Numeric GitHub user ids of bot accounts (e.g. review bots) trusted as
# PR-discussion authors alongside the trusted orgs and users above.
# Comma/space-separated. Optional: unset trusts no bot ids.
# HARNESS_TRUSTED_BOT_IDS=<bot-user-id>

# /api (devbox HTTP interface). Off by default.
API_ENABLED=false
# API_AUTH_ENABLED=true
# API_PUBLIC_BASE_URL=http://localhost:3000
# API_ALLOWED_HOSTS=
# API_TASK_KEY_PREFIX=DBX-API-
# API_SSE_POLL_MS=1000
# API_SSE_MAX_DURATION_MS=600000

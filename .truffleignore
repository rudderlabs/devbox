# Paths the image scanner must not scan, for rudderlabs/build-scan-push-action.
# Its docker-image-scanner.py reads this file with
# pathspec.PathSpec.from_lines("gitwildmatch", ...), so these are
# **gitignore patterns, not regexes**: a leading `^` would be a literal
# character and would match nothing.
#
# Everything listed is third-party or base-OS content baked into the images,
# where the detectors fire on example URIs in library documentation and on byte
# patterns inside compiled objects (tiktoken, jiter, perl). devbox's own code
# under /app and /opt/harness/src is still scanned.

# Dependencies
**/node_modules/**
**/.venv/**

# Package-manager caches the images currently keep
**/.cache/uv/**
**/.cache/node/**

# Toolchains installed into the harness image
/usr/local/go/**

# Base image: distro packages, shared libraries, docs, perl, dpkg state
/usr/lib/**
/usr/share/**
/usr/bin/**
/usr/local/bin/**
/usr/local/lib/**
/var/lib/dpkg/**
/bin/**
/sbin/**
/lib/**

# devbox's own files where TruffleHog's legacy GitLab detector (v1: any 20 to
# 22 character word after "gitlab") flags identifier names such as
# GITLAB_WEBHOOK_SECRET and byoIntegrationsSecret. No token is in them. A
# stopgap: the fix is --exclude-detectors=gitlab.v1 in build-scan-push-action
# (real tokens carry the glpat- prefix, which detectors v2 and v3 catch); drop
# these lines once it has that.
/app/scripts/gitlab/**
/app/scripts/k8s/secrets.ts
/app/scripts/lib/integrations.ts
/app/scripts/lib/secrets.ts
/app/scripts/up.ts
/app/src/integrations/gitlab/**
